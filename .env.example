# ── Environment Variables ──────────────────────────────────────────────────────
# Copy this file to .env and fill in values before running the application.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://intelligrievance_user:your_secure_password@localhost:5432/intelligrievance_db

# SQLite (development — zero config, used automatically if DATABASE_URL not set)
# DATABASE_URL=sqlite:///./backend/intelligrievance.db

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_HEX_STRING_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
